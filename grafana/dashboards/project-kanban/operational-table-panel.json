{
  "id": 8,
  "title": "Projetos — tabela operacional",
  "type": "table",
  "description": "Uma linha por projeto válido; a quantidade de tarefas é pré-agregada por projeto.",
  "gridPos": { "x": 0, "y": 0, "w": 24, "h": 18 },
  "pluginVersion": "13.2.2",
  "datasource": { "type": "mysql", "uid": "glpi-mysql" },
  "targets": [{ "rawSql": "", "refId": "A", "format": "table" }],
  "fieldConfig": {
    "defaults": {
      "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
      "mappings": []
    },
    "overrides": [
      { "matcher": { "id": "byName", "options": "project_id" }, "properties": [
        { "id": "displayName", "value": "ID" },
        { "id": "links", "value": [{ "title": "Abrir projeto no GLPI", "url": "${glpi_base_url}/front/project.form.php?id=${__value.raw}", "targetBlank": true }] }
      ] },
      { "matcher": { "id": "byName", "options": "project_name" }, "properties": [{ "id": "displayName", "value": "Projeto" }] },
      { "matcher": { "id": "byName", "options": "state_name" }, "properties": [{ "id": "displayName", "value": "Estado" }] },
      { "matcher": { "id": "byName", "options": "priority" }, "properties": [
        { "id": "displayName", "value": "Prioridade" },
        { "id": "mappings", "value": [{ "type": "value", "options": { "1": { "text": "Muito baixa" }, "2": { "text": "Baixa" }, "3": { "text": "Média" }, "4": { "text": "Alta" }, "5": { "text": "Muito alta" }, "6": { "text": "Maior" } } }] }
      ] },
      { "matcher": { "id": "byName", "options": "percent_done" }, "properties": [
        { "id": "displayName", "value": "Progresso" }, { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }
      ] },
      { "matcher": { "id": "byName", "options": "task_count" }, "properties": [
        { "id": "displayName", "value": "Tarefas" }, { "id": "decimals", "value": 0 }
      ] }
    ]
  },
  "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
  }
}
