        {
          "datasource": {
            "type": "mysql",
            "uid": "glpi-mysql"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Resolution compliance for solved tickets with a GLPI-calculated TTR deadline.\n-- Uses the stored deadline; SLA calendars are not reconstructed.\nSELECT 100.0 * SUM(CASE WHEN t.solvedate <= t.time_to_resolve THEN 1 ELSE 0 END)\n       / NULLIF(COUNT(*), 0) AS value\nFROM glpi_tickets AS t\nWHERE t.is_deleted = 0\n  AND t.solvedate IS NOT NULL\n  AND t.time_to_resolve IS NOT NULL\n  AND t.entities_id IN ($entity)\n  AND $__timeFilter(t.solvedate);\n",
          "refId": "A"
        }
      ],
