        "spec": {
          "id": 18,
          "title": "",
          "description": "Projetos válidos em outros estados, incluindo os sem estado.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "glpi-mysql"
                      },
                      "spec": {
                        "rawSql": "-- Current snapshot: valid projects outside the finished, in-progress, and unstarted/paused groups.\n-- Projects without a state and unmatched states are counted as Other.\nSELECT COUNT(DISTINCT p.id) AS value\nFROM glpi_projects AS p\nLEFT JOIN glpi_projectstates AS ps\n       ON ps.id = p.projectstates_id\nWHERE p.is_deleted = 0\n  AND p.is_template = 0\n  AND p.entities_id IN ($entity)\n  AND COALESCE(ps.is_finished, 0) = 0\n  AND (\n      p.projectstates_id = 0\n      OR ps.id IS NULL\n      OR ps.name IS NULL\n      OR (\n          LOWER(TRIM(ps.name)) NOT IN (\n              'em andamento',\n              'a fazer'\n          )\n          AND LOWER(TRIM(ps.name)) NOT LIKE '%paus%'\n      )\n  );\n",
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.2",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
