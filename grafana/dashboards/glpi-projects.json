                "defaults": {
                  "unit": "percent",
                  "decimals": 1,
                  "min": 0,
                  "max": 100,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#8657D8"
                  },
                  "displayName": "Média das tarefas ativas"
                },
                "overrides": []
              }
            }
          }
        }
