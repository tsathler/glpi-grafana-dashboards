    {
      "id": 7,
      "title": "Tarefas por estado",
      "type": "barchart",
      "description": "Distribuição de tarefas válidas por estado. O filtro Entity é aplicado pela entidade do projeto pai.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
