    {
      "id": 5,
      "title": "Projetos por estado",
      "type": "barchart",
      "description": "Distribuição de projetos válidos por estado. Projetos sem estado aparecem como Sem estado.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "pluginVersion": "13.2.2",
      "datasource": {
        "type": "mysql",
        "uid": "glpi-mysql"
      },
      "targets": [
        {
          "rawSql": "-- Distribution of valid projects by state; state 0 is labeled generically.\nSELECT CASE\n           WHEN p.projectstates_id = 0 THEN 'Sem estado'\n           ELSE ps.name\n       END AS state_name,\n       COUNT(DISTINCT p.id) AS project_count\nFROM glpi_projects AS p\nLEFT JOIN glpi_projectstates AS ps\n       ON ps.id = p.projectstates_id\nWHERE p.is_deleted = 0\n  AND p.is_template = 0\n  AND p.entities_id IN ($entity)\nGROUP BY p.projectstates_id, ps.name\nORDER BY (p.projectstates_id = 0), state_name;\n",
          "refId": "A",
          "format": "table"
        }
      ],
