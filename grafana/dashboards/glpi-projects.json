              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "glpi-mysql"
                      },
                      "spec": {
                        "rawSql": "-- Current snapshot: valid tasks outside the finished, in-progress, and unstarted groups.\n-- Tasks without a state and unmatched states are counted as Other.\nSELECT COUNT(*) AS value\nFROM glpi_projecttasks AS pt\nJOIN glpi_projects AS p\n     ON p.id = pt.projects_id\nLEFT JOIN glpi_projectstates AS ps\n       ON ps.id = pt.projectstates_id\nWHERE pt.is_deleted = 0\n  AND pt.is_template = 0\n  AND p.is_deleted = 0\n  AND p.is_template = 0\n  AND p.entities_id IN ($entity)\n  AND COALESCE(ps.is_finished, 0) = 0\n  AND (\n      pt.projectstates_id = 0\n      OR ps.id IS NULL\n      OR ps.name IS NULL\n      OR LOWER(TRIM(ps.name)) NOT IN (\n          'em andamento',\n          'a fazer'\n      )\n  );\n",
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.2",
            "spec": {
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "orientation": "auto",
                "textMode": "value_and_name",
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "wideLayout": false,
                "showPercentChange": false,
                "text": {
                  "titleSize": 18,
                  "valueSize": 64
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "none",
                  "decimals": 0,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "#7892A8"
                  },
                  "displayName": "Outras tarefas"
                },
                "overrides": []
              }
            }
          }
        }
      },
