    {
      "id": 1,
      "title": "Projetos não finalizados",
      "type": "stat",
      "description": "Inclui projetos sem estado; estes também são mostrados em Projetos sem estado.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
