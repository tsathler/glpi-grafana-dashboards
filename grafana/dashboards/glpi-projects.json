        "uid": "glpi-mysql"
      },
      "targets": [
        {
          "rawSql": "-- Current snapshot: valid projects whose state is not marked finished.\n-- Projects without a state (projectstates_id = 0) are included as not finished.\nSELECT COUNT(DISTINCT p.id) AS value\nFROM glpi_projects AS p\nLEFT JOIN glpi_projectstates AS ps\n       ON ps.id = p.projectstates_id\nWHERE p.is_deleted = 0\n  AND p.is_template = 0\n  AND p.entities_id IN ($entity)\n  AND (\n      p.projectstates_id = 0\n      OR (ps.id IS NOT NULL AND ps.is_finished = 0)\n  );\n",
          "refId": "A",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
