      "panel-4": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "",
          "description": "Média do percent_done dos projetos válidos em andamento.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
