        "spec": {
          "id": 15,
          "title": "",
          "description": "Média do percent_done das tarefas válidas em andamento.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "mysql",
                      "version": "v0",
                      "datasource": {
                        "name": "glpi-mysql"
                      },
                      "spec": {
                        "rawSql": "-- Average stored progress for valid tasks in the configured Em andamento state.\nSELECT AVG(pt.percent_done) AS average_progress\nFROM glpi_projecttasks AS pt\nJOIN glpi_projects AS p\n     ON p.id = pt.projects_id\nJOIN glpi_projectstates AS ps\n     ON ps.id = pt.projectstates_id\nWHERE pt.is_deleted = 0\n  AND pt.is_template = 0\n  AND p.is_deleted = 0\n  AND p.is_template = 0\n  AND p.entities_id IN ($entity)\n  AND ps.is_finished = 0\n  AND LOWER(TRIM(ps.name)) = 'em andamento';\n",
                        "format": "table"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
