# Initial values only. Replace credentials and database settings for each environment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# This host is for the current Linux host-network setup with MariaDB on the same host.
# Use the reachable database host when deploying with a different network topology.
GLPI_DB_HOST=127.0.0.1
# Default MariaDB port; change it if the target server uses another port.
GLPI_DB_PORT=3306
# Example database and read-only account names; replace them for the target GLPI installation.
GLPI_DB_NAME=glpi
GLPI_DB_USER=grafana_reader
GLPI_DB_PASSWORD=change-me
